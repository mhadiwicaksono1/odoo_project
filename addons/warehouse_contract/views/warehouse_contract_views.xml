<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_warehouse_contract_form" model="ir.ui.view">
            <field name="name">warehouse.contract.form</field>
            <field name="model">warehouse.contract</field>
            <field name="arch" type="xml">
                <form string="Warehouse Contract">
                    <header>
                        <button name="%(action_report_warehouse_contract)d" string="Cetak PDF" type="action" class="oe_highlight" icon="fa-print"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Ketik Nomor Kontrak..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="nota_number"/>
                                <field name="warehouse_name"/>
                                <field name="warehouse_type"/>
                            </group>
                            <group>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Detail Kontrak" name="contract_lines">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="company_id"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="total_months"/>
                                        <field name="grace_period"/>
                                        <field name="billable_months"/>
                                        <field name="monthly_rent"/>
                                        <field name="total_rent" sum="Total Biaya Sewa"/>
                                        <field name="tax_amount" sum="Total Pajak"/>
                                        <field name="total_after_tax" sum="Sewa Setelah Pajak"/>
                                        <field name="revenue_sharing" sum="Total Revenue Sharing"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </tree>
                                </field>
                                <group class="oe_subtotal_footer oe_right" colspan="2" name="contract_total">
                                    <field name="total_rent" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="total_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="total_after_tax" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="total_revenue_sharing" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_warehouse_contract_tree" model="ir.ui.view">
            <field name="name">warehouse.contract.tree</field>
            <field name="model">warehouse.contract</field>
            <field name="arch" type="xml">
                <tree string="Warehouse Contracts">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="nota_number"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="total_after_tax"/>
                    <field name="currency_id" column_invisible="1"/>
                </tree>
            </field>
        </record>

        <!-- Action -->
        <record id="action_warehouse_contract" model="ir.actions.act_window">
            <field name="name">Kontrak Gudang</field>
            <field name="res_model">warehouse.contract</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Buat kontrak gudang pertama Anda!
              </p>
            </field>
        </record>

        <!-- Menus -->
        <menuitem id="menu_warehouse_contract_root" name="Kontrak Gudang" sequence="10"/>
        <menuitem id="menu_warehouse_contract" name="Kontrak Gudang" parent="menu_warehouse_contract_root" action="action_warehouse_contract" sequence="10"/>
    </data>
</odoo>
